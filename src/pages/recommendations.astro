---
import Layout from "@/layouts/Layout.astro";
import RecommendationsPanel from "@/components/RecommendationsPanel";
import { createClient } from "@/lib/supabase";
import { getUserTransactions } from "@/lib/services/transactions";
import { getUserGoals } from "@/lib/services/savings-goals";
import { computeRecommendations } from "@/lib/services/recommendations";
import type { RecommendationsResult } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let hasGoals = false;
let hasTransactions = false;
let result: RecommendationsResult | null = null;
let configError = false;
let fetchError: string | null = null;

if (supabase) {
  try {
    const since = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
    const [transactions, goals] = await Promise.all([getUserTransactions(supabase, since), getUserGoals(supabase)]);
    hasGoals = goals.length > 0;
    hasTransactions = transactions.length > 0;
    if (hasGoals && hasTransactions) {
      result = computeRecommendations(transactions, goals);
    }
  } catch (err) {
    fetchError = err instanceof Error ? err.message : "An unexpected error occurred.";
  }
} else {
  configError = true;
}
---

<Layout title="Recommendations — SpendLens">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4 pt-12">
    <div class="w-full max-w-3xl">
      <h1 class="mb-8 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Recommendations
      </h1>

      {
        configError && (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-sm text-red-200">Database is not configured. Please check your environment variables.</p>
          </div>
        )
      }

      {
        fetchError && (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="mb-1 font-semibold text-red-200">Could not load recommendations</p>
            <p class="text-sm text-red-300/70">
              Please try refreshing the page. If the problem persists, contact support.
            </p>
          </div>
        )
      }

      {
        !configError && !fetchError && !hasGoals && (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="mb-2 text-lg font-semibold">No savings goals yet</p>
            <p class="mb-6 text-sm text-blue-100/70">
              Create a savings goal to get personalised expense-cutting suggestions.
            </p>
            <a
              href="/goals/new"
              class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium transition-colors hover:bg-white/20"
            >
              Create a savings goal
            </a>
          </div>
        )
      }

      {
        !configError && !fetchError && hasGoals && !hasTransactions && (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="mb-2 text-lg font-semibold">No transactions imported</p>
            <p class="mb-6 text-sm text-blue-100/70">
              Import your bank transactions so we can analyse your spending patterns.
            </p>
            <a
              href="/transactions/import"
              class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium transition-colors hover:bg-white/20"
            >
              Connect your bank account
            </a>
          </div>
        )
      }

      {result && <RecommendationsPanel result={result} client:load />}
    </div>
  </div>
</Layout>
