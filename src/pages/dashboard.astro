---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import SpendingSummary from "@/components/SpendingSummary";
import { createClient } from "@/lib/supabase";
import { getUserTransactions } from "@/lib/services/transactions";
import { computeSpendingSummary } from "@/lib/services/spending-summary";
import type { SpendingSummary as SpendingSummaryData } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let hasTransactions = false;
let summary: SpendingSummaryData | null = null;
let configError = false;
let fetchError: string | null = null;

if (supabase) {
  try {
    const now = new Date();
    // First of the current calendar month. Built from the same (local) calendar
    // components computeSpendingSummary uses for its window, so the DB lower-bound
    // and the in-service filter always agree — no local→UTC round-trip that could
    // shift the month on a non-UTC host (lessons.md: no ambient-timezone reliance).
    const since = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-01`;
    const transactions = await getUserTransactions(supabase, since);
    hasTransactions = transactions.length > 0;
    summary = computeSpendingSummary(transactions, now);
  } catch (err) {
    fetchError = err instanceof Error ? err.message : "An unexpected error occurred.";
  }
} else {
  configError = true;
}
---

<Layout title="Dashboard — SpendLens">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4 pt-12">
    <div class="w-full max-w-3xl">
      <Topbar />
      <h1 class="mb-8 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>

      {
        configError && (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-sm text-red-200">Database is not configured. Please check your environment variables.</p>
          </div>
        )
      }

      {
        fetchError && (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="mb-1 font-semibold text-red-200">Could not load your spending summary</p>
            <p class="text-sm text-red-300/70">
              Please try refreshing the page. If the problem persists, contact support.
            </p>
          </div>
        )
      }

      {
        !configError && !fetchError && !hasTransactions && (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="mb-2 text-lg font-semibold">No transactions imported</p>
            <p class="mb-6 text-sm text-blue-100/70">
              Import your bank transactions so we can summarise your spending by category.
            </p>
            <a
              href="/transactions/import"
              class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium transition-colors hover:bg-white/20"
            >
              Connect your bank account
            </a>
          </div>
        )
      }

      {!configError && !fetchError && hasTransactions && summary && <SpendingSummary summary={summary} />}
    </div>
  </div>
</Layout>
