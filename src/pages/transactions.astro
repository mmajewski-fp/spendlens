---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getUserTransactions } from "@/lib/services/transactions";
import { formatSignedAmount } from "@/lib/format-money";
import type { TransactionWithCategory } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let transactions: TransactionWithCategory[] = [];
let hasTransactions = false;
let configError = false;
let fetchError: string | null = null;

if (supabase) {
  try {
    transactions = await getUserTransactions(supabase);
    hasTransactions = transactions.length > 0;
  } catch (err) {
    fetchError = err instanceof Error ? err.message : "An unexpected error occurred.";
  }
} else {
  configError = true;
}
---

<Layout title="Transactions — SpendLens">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4 pt-12">
    <div class="w-full max-w-3xl">
      <Topbar />
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Transactions
      </h1>

      {
        hasTransactions && (
          <div class="mb-8 flex items-center justify-between gap-4">
            <p class="text-sm text-blue-100/60">
              Showing {transactions.length} transaction{transactions.length === 1 ? "" : "s"}
            </p>
            <a
              href="/api/transactions/export"
              download
              class="shrink-0 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20"
            >
              Export CSV
            </a>
          </div>
        )
      }

      {
        configError && (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-sm text-red-200">Database is not configured. Please check your environment variables.</p>
          </div>
        )
      }

      {
        fetchError && (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="mb-1 font-semibold text-red-200">Could not load your transactions</p>
            <p class="text-sm text-red-300/70">
              Please try refreshing the page. If the problem persists, contact support.
            </p>
          </div>
        )
      }

      {
        !configError && !fetchError && !hasTransactions && (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="mb-2 text-lg font-semibold">No transactions imported</p>
            <p class="mb-6 text-sm text-blue-100/70">
              Import your bank transactions to see your full expense and income history here.
            </p>
            <a
              href="/transactions/import"
              class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium transition-colors hover:bg-white/20"
            >
              Connect your bank account
            </a>
          </div>
        )
      }

      {
        !configError && !fetchError && hasTransactions && (
          <ul class="space-y-3">
            {transactions.map((t) => (
              <li class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl">
                <div class="min-w-0">
                  <p class="truncate font-medium text-white">{t.description ?? "Transaction"}</p>
                  <div class="mt-1 flex items-center gap-2 text-xs text-blue-100/60">
                    <span>{t.date}</span>
                    <span class="rounded-full border border-white/15 bg-white/10 px-2 py-0.5 text-blue-100/80">
                      {t.category?.name ?? "Other"}
                    </span>
                  </div>
                </div>
                <span
                  class:list={`shrink-0 font-semibold ${t.type === "income" ? "text-emerald-300" : "text-rose-300"}`}
                >
                  {formatSignedAmount(t.amount, t.type)}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
