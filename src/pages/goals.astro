---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GoalsManager from "@/components/goals/GoalsManager";
import { createClient } from "@/lib/supabase";
import { getUserGoals } from "@/lib/services/savings-goals";
import type { SavingsGoal } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let goals: SavingsGoal[] = [];
let configError = false;
let fetchError: string | null = null;

if (supabase) {
  try {
    goals = await getUserGoals(supabase);
  } catch (err) {
    fetchError = err instanceof Error ? err.message : "An unexpected error occurred.";
  }
} else {
  configError = true;
}
---

<Layout title="Goals — SpendLens">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4 pt-12">
    <div class="w-full max-w-3xl">
      <Topbar />
      <h1 class="mb-8 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Savings Goals
      </h1>

      {
        configError && (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-sm text-red-200">Database is not configured. Please check your environment variables.</p>
          </div>
        )
      }

      {
        fetchError && (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="mb-1 font-semibold text-red-200">Could not load savings goals</p>
            <p class="text-sm text-red-300/70">
              Please try refreshing the page. If the problem persists, contact support.
            </p>
          </div>
        )
      }

      {!configError && !fetchError && <GoalsManager client:load initialGoals={goals} />}
    </div>
  </div>
</Layout>
