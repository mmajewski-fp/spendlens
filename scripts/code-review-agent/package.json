{
  "name": "code-review-agent",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Claude Agent SDK code review agent: scores a diff against the team's criteria and returns a gate-able verdict",
  "scripts": {
    "review": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "eval": "promptfoo eval -c promptfooconfig.yaml",
    "eval:view": "promptfoo view"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.217",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "promptfoo": "^0.122.2",
    "typescript": "^5.9.3"
  }
}
