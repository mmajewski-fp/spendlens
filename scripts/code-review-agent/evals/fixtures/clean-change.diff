@@ -1,3 +1,15 @@
 export function formatCents(cents: number): string {
   return (cents / 100).toFixed(2);
 }
+
+/**
+ * Sort category names for display. Uses codepoint ordering rather than
+ * localeCompare so the result is identical on every machine and CI worker.
+ */
+export function sortCategoryNames(names: readonly string[]): string[] {
+  return [...names].sort((a, b) => {
+    if (a === b) return 0;
+    return a < b ? -1 : 1;
+  });
+}
